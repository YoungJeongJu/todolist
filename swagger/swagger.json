            "description": "상태 필터. OVERDUE는 파생 상태(dueDate < 오늘 AND status != DONE)로 필터링합니다.",
            "schema": {
              "type": "string",
              "enum": ["NOT_STARTED", "IN_PROGRESS", "DONE", "OVERDUE"]
            }
          },
          {
            "name": "categoryId",
