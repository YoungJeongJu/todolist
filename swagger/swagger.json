                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "UNAUTHORIZED",
                    "message": "인증이 필요합니다."
                  }
                }
              }
            }
          }
        }
